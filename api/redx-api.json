  },
  {
   "id": "packPut",
   "group": "files",
   "method": "PUT",
   "path": "/v1/db/{db}/pack/{pack}/file/{file}",
   "auth": "write",
   "danger": "write",
   "summary": "Upload a file (streamed; X-Redx-SHA256 verified).",
   "response": "json",
   "request": "binary"
  },
  {
   "id": "packDelete",
   "group": "files",
   "method": "DELETE",
   "path": "/v1/db/{db}/pack/{pack}/file/{file}",
   "auth": "write",
   "danger": "write",
   "summary": "Delete a file.",
   "response": "json"
  },
  {
   "id": "packGc",
   "group": "files",
   "method": "POST",
   "path": "/v1/db/{db}/pack/{pack}/gc",
   "auth": "admin",
   "danger": "admin",
   "summary": "Free chunks of deleted or replaced files.",
   "response": "json"
  },
  {
   "id": "packFsck",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/pack/{pack}/fsck",
   "auth": "admin",
   "danger": "safe",
   "summary": "Integrity report (changes nothing).",
   "response": "json",
   "query": {
    "deep": "boolean"
   }
  },
  {
   "id": "listMedia",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/media",
   "auth": "read",
   "danger": "safe",
   "summary": "Media libraries of a database.",
   "response": "json"
  },
  {
   "id": "mediaList",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/media/{lib}",
   "auth": "read",
   "danger": "safe",
   "summary": "Items of a media library.",
   "response": "json"
  },
  {
   "id": "mediaStat",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/media/{lib}/stat/{name}",
   "auth": "read",
   "danger": "safe",
   "summary": "One item's manifest.",
   "response": "json"
  },
  {
   "id": "mediaGet",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/media/{lib}/file/{name}",
   "auth": "read",
   "danger": "safe",
   "summary": "Download an item (HTTP Range supported).",
   "response": "binary"
  },
  {
   "id": "mediaPut",
   "group": "files",
   "method": "PUT",
   "path": "/v1/db/{db}/media/{lib}/file/{name}",
   "auth": "write",
   "danger": "write",
   "summary": "Upload an item (?type= declares the media type).",
   "response": "json",
   "request": "binary",
   "query": {
    "type": "string"
   }
  },
  {
   "id": "mediaDelete",
   "group": "files",
   "method": "DELETE",
   "path": "/v1/db/{db}/media/{lib}/file/{name}",
   "auth": "write",
   "danger": "write",
   "summary": "Delete an item.",
   "response": "json"
  },
  {
