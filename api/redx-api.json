  },
  {
   "id": "rebuildIndex",
   "group": "database",
   "method": "POST",
   "path": "/v1/db/{db}/idx/{set}/rebuild",
   "auth": "admin",
   "danger": "admin",
   "summary": "Rebuild an index set from the data.",
   "response": "json"
  },
  {
   "id": "checkIndex",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/idx/{set}/check",
   "auth": "read",
   "danger": "safe",
   "summary": "Compare an index set with the data.",
   "response": "json"
  },
  {
   "id": "getRules",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/pulse",
   "auth": "read",
   "danger": "safe",
   "summary": "Pulse rules and pending timers.",
   "response": "json"
  },
  {
   "id": "putRules",
   "group": "database",
   "method": "PUT",
   "path": "/v1/db/{db}/pulse",
   "auth": "admin",
   "danger": "admin",
   "summary": "Replace the rule set (Box text, validated first).",
   "response": "json",
   "request": "text"
  },
  {
   "id": "deleteRules",
   "group": "database",
   "method": "DELETE",
   "path": "/v1/db/{db}/pulse",
   "auth": "admin",
   "danger": "admin",
   "summary": "Remove all rules.",
   "response": "json"
  },
  {
   "id": "rulesSubscribe",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/pulse/subscribe",
   "auth": "read",
   "danger": "safe",
   "summary": "WebSocket: rule events.",
   "response": "websocket",
   "query": {
    "topic": "string",
    "changes": "boolean"
   }
  },
  {
   "id": "getPolicy",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/sec",
   "auth": "read",
   "danger": "safe",
   "summary": "Access policy summary (source for admins).",
   "response": "json"
  },
  {
   "id": "putPolicy",
   "group": "database",
   "method": "PUT",
   "path": "/v1/db/{db}/sec",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "Replace the access policy (changes who can read what).",
   "response": "json",
   "request": "text",
   "notes": "Server requires header X-RedX-Confirm: putPolicy (or ?confirm=putPolicy); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "deletePolicy",
   "group": "database",
   "method": "DELETE",
   "path": "/v1/db/{db}/sec",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "Remove the access policy.",
   "response": "json",
   "notes": "Server requires header X-RedX-Confirm: deletePolicy (or ?confirm=deletePolicy); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "listScripts",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/code",
   "auth": "read",
   "danger": "safe",
   "summary": "Script files of a database.",
   "response": "json"
  },
  {
   "id": "putScript",
   "group": "database",
   "method": "PUT",
