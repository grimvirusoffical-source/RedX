{
 "name": "RedX HTTP API",
 "version": "1",
 "api": "/v1",
 "notes": "Source of truth for the RedX SDKs. scripts/gensdk turns it into api/openapi.json and the operation tables of every SDK. Change the API here first.",
 "auth": {
  "none": "no key",
  "key": "any valid key",
  "read": "key with read scope on the database",
  "write": "write scope on the database",
  "admin": "admin scope on the database",
  "host-admin": "admin key for all databases (db \"*\")",
  "app-key": "the app's own key from the connect flow"
 },
 "danger": [
  {
   "name": "safe",
   "level": 0,
   "meaning": "reads only"
  },
  {
   "name": "write",
   "level": 1,
   "meaning": "changes data inside the key's own scope"
  },
  {
   "name": "admin",
   "level": 2,
   "meaning": "changes host or database definitions; reversible"
  },
  {
   "name": "dangerous",
   "level": 3,
   "meaning": "irreversible, grants or removes access, or moves leadership; SDKs refuse it unless the call is explicitly confirmed"
  }
 ],
 "rottenAppleLevels": {
  "safe": "L1",
  "write": "L1",
  "admin": "developer-tool",
  "dangerous": "developer-tool",
  "notes": "safe and write calls on the app's own workspace are the data.redx service (L1 in Rotten Apple's SDK levels). admin and dangerous calls are developer and operator tools only: they must not be exposed to in-app code through the launcher."
 },
 "operations": [
  {
   "id": "health",
   "group": "host",
   "method": "GET",
   "path": "/healthz",
   "auth": "none",
   "danger": "safe",
   "summary": "Liveness, node id, role and version (no key needed).",
   "response": "json"
  },
  {
   "id": "whoami",
   "group": "host",
   "method": "GET",
   "path": "/v1/ui/whoami",
   "auth": "key",
   "danger": "safe",
   "summary": "The calling key's id, scope, database and prefix.",
   "response": "json"
  },
  {
   "id": "stats",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/stats",
   "auth": "read",
   "danger": "safe",
   "summary": "Engine and host counters of a database.",
   "response": "json",
   "shorthand": "/v1/stats"
  },
  {
   "id": "listDatabases",
   "group": "host",
   "method": "GET",
   "path": "/v1/dbs",
   "auth": "read",
   "danger": "safe",
   "summary": "Databases the key can see.",
   "response": "json"
  },
  {
   "id": "createDatabase",
   "group": "host",
   "method": "POST",
   "path": "/v1/dbs",
   "auth": "host-admin",
   "danger": "admin",
   "summary": "Create a database.",
   "response": "json",
   "body": {
    "name": "string"
   }
  },
  {
   "id": "deleteDatabase",
   "group": "host",
   "method": "DELETE",
   "path": "/v1/db/{db}",
   "auth": "host-admin",
   "danger": "dangerous",
   "summary": "Delete a database and all its files (irreversible).",
   "response": "json",
   "query": {
    "confirm": "string"
   },
   "hostConfirm": "db",
   "notes": "The host also wants the database name repeated as ?confirm=<db>; SDKs add it when the call is confirmed.; Server requires header X-RedX-Confirm: deleteDatabase (or ?confirm=deleteDatabase); HTTP 428 + code confirm_required otherwise. Host also accepts ?confirm=<db> (existing deleteDatabase guard)."
  },
  {
   "id": "validate",
   "group": "host",
   "method": "POST",
   "path": "/v1/ui/validate",
   "auth": "read",
   "danger": "safe",
   "summary": "Parse Box text, BoxQL or a policy and report line:col errors.",
   "response": "json",
   "body": {
    "kind": "string",
    "text": "string"
   }
  },
  {
   "id": "adminStatus",
   "group": "host",
   "method": "GET",
   "path": "/v1/admin/status",
   "auth": "host-admin",
   "danger": "safe",
   "summary": "Dashboard status: version, data dir, TLS, cluster, warnings.",
   "response": "json"
  },
  {
   "id": "adminAudit",
   "group": "host",
   "method": "GET",
   "path": "/v1/admin/audit",
   "auth": "host-admin",
   "danger": "safe",
   "summary": "Newest audit events (never contain keys).",
   "response": "json",
   "query": {
    "limit": "integer"
   }
  },
  {
   "id": "adminConfig",
   "group": "host",
   "method": "GET",
   "path": "/v1/admin/config",
   "auth": "host-admin",
   "danger": "safe",
   "summary": "Effective configuration with secrets hidden.",
   "response": "json"
  },
  {
   "id": "listPresets",
   "group": "host",
   "method": "GET",
   "path": "/v1/admin/presets",
   "auth": "host-admin",
   "danger": "safe",
   "summary": "Settings presets with every value and reason.",
   "response": "json"
  },
  {
   "id": "backup",
   "group": "host",
   "method": "GET",
   "path": "/v1/admin/backup",
   "auth": "host-admin",
   "danger": "admin",
   "summary": "Online backup of all databases and keys as one archive (contains everything: store it safely).",
   "response": "binary",
   "notes": "Restore is offline only (redx restore FILE with the host stopped); there is no HTTP restore."
  },
  {
   "id": "listFiles",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/files",
   "auth": "admin",
   "danger": "safe",
   "summary": "Files of a database with type and size.",
   "response": "json"
  },
  {
   "id": "listKeys",
   "group": "keys",
   "method": "GET",
   "path": "/v1/keys",
   "auth": "admin",
   "danger": "safe",
   "summary": "Keys (ids, scopes, status; never the secrets).",
   "response": "json"
  },
  {
   "id": "getKey",
   "group": "keys",
   "method": "GET",
   "path": "/v1/keys/{id}",
   "auth": "admin",
   "danger": "safe",
   "summary": "One key's details.",
   "response": "json"
  },
  {
   "id": "createKey",
   "group": "keys",
   "method": "POST",
   "path": "/v1/keys",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "Create an API key; the secret is returned once.",
   "response": "json",
   "body": {
    "db": "string",
    "scope": "string",
    "prefix": "string",
    "label": "string",
    "ttl": "string",
    "roles": "array",
    "rate_rps": "number",
    "rate_burst": "integer"
   },
   "notes": "Server requires header X-RedX-Confirm: createKey (or ?confirm=createKey); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "revokeKey",
   "group": "keys",
   "method": "DELETE",
   "path": "/v1/keys/{id}",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "Revoke a key at once.",
   "response": "json",
   "notes": "Server requires header X-RedX-Confirm: revokeKey (or ?confirm=revokeKey); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "rotateKey",
   "group": "keys",
   "method": "POST",
   "path": "/v1/keys/{id}/rotate",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "Issue a replacement key; the old one stops after the grace period.",
   "response": "json",
   "body": {
    "grace": "string"
   },
   "notes": "Server requires header X-RedX-Confirm: rotateKey (or ?confirm=rotateKey); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "createPairingCode",
   "group": "keys",
   "method": "POST",
   "path": "/v1/keys/pairing",
   "auth": "admin",
   "danger": "dangerous",
   "summary": "One-time sign-in code (5 min) that another device trades for a new key.",
   "response": "json",
   "body": {
    "db": "string",
    "scope": "string",
    "label": "string",
    "ttl": "string"
   },
   "notes": "Server requires header X-RedX-Confirm: createPairingCode (or ?confirm=createPairingCode); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "pairExchange",
   "group": "keys",
   "method": "POST",
   "path": "/v1/pair/exchange",
   "auth": "none",
   "danger": "write",
   "summary": "Trade a sign-in code for a key.",
   "response": "json",
   "body": {
    "code": "string"
   }
  },
  {
   "id": "getPath",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/path/{path}",
   "auth": "read",
   "danger": "safe",
   "summary": "Read the value at a path ({path, value} with value as Box text).",
   "response": "json",
   "shorthand": "/v1/path/{path}",
   "query": {
    "resolve": "boolean",
    "depth": "integer"
   }
  },
  {
   "id": "getPathBox",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/path/{path}",
   "auth": "read",
   "danger": "safe",
   "summary": "Read the value at a path as raw Box text.",
   "response": "text",
   "shorthand": "/v1/path/{path}"
  },
  {
   "id": "setPath",
   "group": "database",
   "method": "PUT",
   "path": "/v1/db/{db}/path/{path}",
   "auth": "write",
   "danger": "write",
   "summary": "Write a value (JSON envelope or Box text) with optional TTL.",
   "response": "json",
   "shorthand": "/v1/path/{path}",
   "body": {
    "value": "any",
    "ttl_seconds": "integer",
    "sliding": "boolean",
    "checkpoint_seconds": "integer"
   },
   "query": {
    "ttl": "integer",
    "sliding": "boolean",
    "checkpoint": "integer"
   }
  },
  {
   "id": "deletePath",
   "group": "database",
   "method": "DELETE",
   "path": "/v1/db/{db}/path/{path}",
   "auth": "write",
   "danger": "write",
   "summary": "Delete the value at a path.",
   "response": "json",
   "shorthand": "/v1/path/{path}"
  },
  {
   "id": "pathQuery",
   "group": "database",
   "method": "POST",
   "path": "/v1/db/{db}/query",
   "auth": "read",
   "danger": "safe",
   "summary": "Path-pattern query, e.g. file:Box[ID=*].Name.",
   "response": "json",
   "shorthand": "/v1/query",
   "body": {
    "q": "string"
   }
  },
  {
   "id": "bx",
   "group": "database",
   "method": "POST",
   "path": "/v1/db/{db}/bx",
   "auth": "read",
   "danger": "write",
   "summary": "Run one BoxQL command or {Tx[]} transaction with $params.",
   "response": "json",
   "shorthand": "/v1/bx",
   "body": {
    "q": "string",
    "params": "object",
    "explain": "boolean"
   },
   "notes": "Get/Require/Explain need read; Add/Set/Delete and a Tx containing one need write."
  },
  {
   "id": "bxWatch",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/bx/watch",
   "auth": "read",
   "danger": "safe",
   "summary": "WebSocket: stream changes matching a {Watch[]} command.",
   "response": "websocket",
   "shorthand": "/v1/bx/watch",
   "query": {
    "q": "string",
    "params": "string"
   }
  },
  {
   "id": "subscribe",
   "group": "database",
   "method": "GET",
   "path": "/v1/db/{db}/subscribe",
   "auth": "read",
   "danger": "safe",
   "summary": "WebSocket: stream changes under a path prefix.",
   "response": "websocket",
   "shorthand": "/v1/subscribe",
   "query": {
    "path": "string"
   }
  },
  {
   "id": "listPacks",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/pack",
   "auth": "read",
   "danger": "safe",
   "summary": "File packs of a database.",
   "response": "json"
  },
  {
   "id": "packList",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/pack/{pack}/ls/{folder}",
   "auth": "read",
   "danger": "safe",
   "summary": "List a folder of a pack.",
   "response": "json"
  },
  {
   "id": "packStat",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/pack/{pack}/stat/{file}",
   "auth": "read",
   "danger": "safe",
   "summary": "One file's size, hash and type.",
   "response": "json"
  },
  {
   "id": "packGet",
   "group": "files",
   "method": "GET",
   "path": "/v1/db/{db}/pack/{pack}/file/{file}",
   "auth": "read",
