   "danger": "safe",
   "summary": "Query an index (exact, prefix, range, text).",
   "response": "json",
   "query": {
    "mode": "string",
    "field": "string",
    "value": "string",
    "lo": "string",
    "hi": "string",
    "q": "string",
    "op": "string",
    "limit": "integer",
