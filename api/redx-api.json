   }
  },
  {
   "id": "clusterStatus",
   "group": "cluster",
   "method": "GET",
   "path": "/v1/cluster/status",
   "auth": "host-admin",
   "danger": "safe",
   "summary": "Role, leader, members, replication offsets, fence.",
   "response": "json"
  },
  {
   "id": "createJoinToken",
   "group": "cluster",
   "method": "POST",
   "path": "/v1/cluster/join-token",
   "auth": "host-admin",
   "danger": "dangerous",
   "summary": "Join token or pairing code that lets a node join and receive all data.",
   "response": "json",
   "body": {
    "ttl_seconds": "integer",
    "kind": "string"
   },
   "notes": "Server requires header X-RedX-Confirm: createJoinToken (or ?confirm=createJoinToken); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "promote",
   "group": "cluster",
   "method": "POST",
   "path": "/v1/cluster/promote",
   "auth": "host-admin",
   "danger": "dangerous",
