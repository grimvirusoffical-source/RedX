   "body": {
    "url": "string",
    "join_token": "string",
    "pin_sha256": "string"
   },
   "notes": "Server requires header X-RedX-Confirm: repoint (or ?confirm=repoint); HTTP 428 + code confirm_required otherwise."
  },
  {
   "id": "connectStart",
   "group": "connect",
   "method": "POST",
   "path": "/v1/connect/start",
   "auth": "host-admin",
   "danger": "admin",
   "summary": "Register an app's connect request (what the console does with a link).",
