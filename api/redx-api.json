   "request": "text"
  },
  {
   "id": "dropIndex",
   "group": "database",
   "method": "DELETE",
   "path": "/v1/db/{db}/idx/{set}",
   "auth": "admin",
   "danger": "admin",
   "summary": "Drop an index set (the data stays).",
