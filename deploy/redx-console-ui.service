[Unit]
Description=Red-XAI read-only legacy database console frontend proxy
After=network-online.target redx-redxd.service
Wants=network-online.target

[Service]
Type=simple
User=redx
Group=redx
WorkingDirectory=/opt/redx/lib
ExecStart=/usr/bin/node /opt/redx/lib/ui-console-proxy.cjs
Environment=NODE_ENV=production
Environment=REDX_CONSOLE_PROXY_PORT=17782
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
