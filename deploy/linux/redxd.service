[Unit]
Description=RedX database host
Documentation=file:///usr/share/doc/redx/hosting.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=redx
Group=redx
ExecStart=/usr/bin/redxd run --config /etc/redx/redx.toml --no-open
Restart=on-failure
RestartSec=3
# No secret is ever printed to the journal: create the first admin key offline (see the package message).
Environment=REDX_NO_BOOTSTRAP=1
EnvironmentFile=-/etc/redx/redxd.env
StateDirectory=redx
StateDirectoryMode=0700
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/redx

[Install]
WantedBy=multi-user.target
